# Docker defaults. Loaded because APP_ENV=docker -> config reads `.env.docker`.
# Override at runtime with `environment:` in compose or `docker run -e`.
# When Redis/Prometheus run outside this compose file on a Mac/Windows host,
# `host.docker.internal` reaches the host. On Linux with host networking use
# `localhost`, or set the container/service name when sharing a network.

# Redis Configs (containers on 901-reactive-gateway resolve via service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DECODE_RESPONSE=True
REDIS_ADVISORY_ALERT_CHANNEL=circuit-breaker-channel
REDIS_ADVISORY_ALERT_ON=True

# Prometheus Configs (prometheus container on 901-reactive-gateway)
PROMETHEUS_BASE_URL=http://prometheus:9090
PROMETHEUS_QUERY_SERVICE_NAMES=["payment_service", "inventory_service"]

# Prediction Configs
MODEL_BUNDLE_FILE=models/proactive_gateway_mdv3_v1.joblib

# Scheduler Configs
PREDICTION_SCHEDULE_INTERVAL_SECONDS=15
EXPORT_TIMESERIES_DATA=False
