# Redis Configs
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DECODE_RESPONSE=True
REDIS_ADVISORY_ALERT_CHANNEL=circuit-breaker-channel

# Prometheus Configs
PROMETHEUS_BASE_URL = "http://localhost:9090"
PROMETHEUS_QUERY_SERVICE_NAMES = ["payment_service", "inventory_service"]

# Prediction Configs
MODEL_BUNDLE_FILE = "models/proactive_gateway_mdv3_v1.joblib"

# Scheduler Configs
PREDICTION_SCHEDULE_INTERVAL_SECONDS=15
EXPORT_TIMESERIES_DATA=True